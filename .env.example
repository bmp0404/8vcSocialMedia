# ---------------------------------------------------------------- LLM
# Which LLM backend to use: anthropic | xai | openai | mock
HARNESS_PROVIDER=mock
# Model id for the chosen provider (anthropic defaults to claude-sonnet-5-5)
HARNESS_MODEL=
# Anthropic only: reasoning effort low | medium | high | xhigh | max (blank = the model's default)
HARNESS_EFFORT=

ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
# Optional: any OpenAI-compatible gateway (OpenRouter, LiteLLM, ...)
OPENAI_BASE_URL=

# ---------------------------------------------------------------- brand + memory
# Mission file (brand, voice, product facts, audience panel). Relative paths resolve from the repo root.
HARNESS_MISSION=mission/mission.md
# Watchlist + search keywords. Blank = <mission stem>_targets.json next to the mission, if it exists.
HARNESS_TARGETS=
# SQLite memory (actions table). Use a throwaway path for demos; non-default DBs tag out/ file names.
HARNESS_DB=data/harness.db
# Lessons file both lanes recall; rewritten by `python -m harness learn`
HARNESS_LESSONS=memory/lessons.md
# Learn outputs (harness/learn.py): per-mind/type weights and mission-edit proposals
HARNESS_WEIGHTS=
HARNESS_PROPOSALS=out/mission-proposals.md
# Reply lane: recommendation slots reserved for follows (ranked outside the audience panel)
HARNESS_FOLLOW_SLOTS=2
# Pre-posting evaluator: reply triage gate + panel/pairwise ranking (on | off, for A/B runs)
HARNESS_EVALUATOR=on

# ---------------------------------------------------------------- observe (sources)
# Comma-separated source plugins: sample | feed | x_api | reddit  (see harness/sources/__init__.py)
HARNESS_SOURCES=sample
# feed: teammate scraper output; a file, a glob (data/scrape/*.jsonl) or a directory of .json/.jsonl/.csv
HARNESS_FEED_PATH=
# feed: trim big exports per run, newest first (blank = keep everything)
HARNESS_FEED_SINCE_DAYS=
HARNESS_FEED_LIMIT=
# reddit: plus-separated subreddits (needs OAuth before it works; see sources/reddit.py)
HARNESS_SUBREDDITS=

# x_api: X API v2 app-only bearer token
X_BEARER_TOKEN=
# Full search query; overrides everything below
X_SEARCH_QUERY=
# Comma-separated keywords; overrides the targets file's keywords
X_SEARCH_KEYWORDS=
# Default query built from the targets file: both | keywords | accounts (from: priority handles)
X_QUERY_MODE=both
# Terms past this length are dropped (512 = X basic tier)
X_QUERY_MAX_LEN=512
# Max signals returned by x_api
X_MAX_RESULTS=25
# scripts/smoke_x_api.py: handle to test timeline lookup with
X_HANDLE=

# ---------------------------------------------------------------- hand-off email
# `python -m harness run --email` dry-runs to out/handoff-<run>.eml/.txt; add --send to actually send.
# Port 587 = STARTTLS, 465 = SSL. Gmail: smtp.gmail.com + an app password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Default: SMTP_USER
HANDOFF_EMAIL_FROM=
# Comma-separated
HANDOFF_EMAIL_TO=
HANDOFF_EMAIL_CC=
