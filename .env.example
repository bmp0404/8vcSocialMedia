# Which LLM backend to use: anthropic | xai | openai | mock
HARNESS_PROVIDER=mock
# Model id for the chosen provider (anthropic defaults to claude-sonnet-5-5)
HARNESS_MODEL=

ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
# Optional: any OpenAI-compatible gateway (OpenRouter, LiteLLM, ...)
OPENAI_BASE_URL=

# Comma-separated source plugins to run (see harness/sources/__init__.py)
HARNESS_SOURCES=devtools,hn
